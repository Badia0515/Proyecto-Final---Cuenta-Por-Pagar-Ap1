<div class="card shadow-sm h-100">
    <div class="card-header bg-white d-flex align-items-center gap-2">
        <label class="bi bi-info-circle text-success fs-5 mb-0"></label>
        <h6 class="mb-0 fw-bold">Detalle del Pago</h6>
    </div>

    <div class="card-body d-flex flex-column justify-content-between">
        @if (PagoSeleccionado == null || PagoSeleccionado.PagosId == 0)
        {
            <div class="text-center text-muted my-auto py-5">
                Selecciona una programación de la tabla para ver su detalle.
            </div>
        }
        else
        {
            <div>
                <div class="row mb-2 align-items-center">
                    <div class="col-6 text-muted small">
                        <span class="bi bi-calendar-check text-success me-2"></span><strong>No. Programación:</strong>
                    </div>
                    <div class="col-6 fw-semibold">
                        PP-@PagoSeleccionado.PagosId.ToString("D4")
                    </div>
                </div>

                <div class="row mb-2 align-items-center">
                    <div class="col-6 text-muted small">
                        <span class="bi bi-file-earmark-text text-success me-2"></span><strong>Factura:</strong>
                    </div>
                    <div class="col-6 fw-semibold">
                        F-@(PagoSeleccionado.Factura?.NumFactura.ToString("D4") ?? "0000")
                    </div>
                </div>

                <div class="row mb-2 align-items-center">
                    <div class="col-6 text-muted small">
                        <span class="bi bi-person text-success me-2"></span><strong>Proveedor:</strong>
                    </div>
                    <div class="col-6 fw-semibold">
                        @(PagoSeleccionado.Factura?.Proveedor?.Nombre ?? "--")
                    </div>
                </div>

                <div class="row mb-2 align-items-center">
                    <div class="col-6 text-muted small">
                        <span class="bi bi-calendar-event text-success me-2"></span><strong>Fecha de Pago:</strong>
                    </div>
                    <div class="col-6">
                        @PagoSeleccionado.FechaProgramada.ToString("dd/MM/yyyy")
                    </div>
                </div>

                <div class="row mb-2 align-items-center">
                    <div class="col-6 text-muted small">
                        <span class="bi bi-credit-card text-success me-2"></span><strong>Tipo de Pago:</strong>
                    </div>
                    <div class="col-6">
                        @PagoSeleccionado.TipoPago
                    </div>
                </div>

                <div class="row mb-3 align-items-center">
                    <div class="col-6 text-muted small">
                        <span class="bi bi-cash-stack text-success me-2"></span><strong>Monto:</strong>
                    </div>
                    <div class="col-6 fw-bold text-success fs-6">
                        RD$ @PagoSeleccionado.Monto.ToString("N2")
                    </div>
                </div>

                <div class="mb-3">
                    <div class="text-muted small mb-2">
                        <span class="bi bi-chat-left-text text-success me-2"></span><strong>Referencia:</strong>
                    </div>
                    <div class="border rounded bg-light p-3 text-muted small" style="min-height: 80px;">
                        @(string.IsNullOrWhiteSpace(PagoSeleccionado.Referencia) ? "Sin referencia." : PagoSeleccionado.Referencia)
                    </div>
                </div>
            </div>

            @if (PagoSeleccionado.Estado == "Por Aprobar" || PagoSeleccionado.Estado == "Pendiente de aprobacion")
            {
                <div class="d-flex gap-2 mt-3">
                    <button type="button"
                            class="btn btn-success w-50 bi bi-check-lg"
                            @onclick="() => OnAprobar.InvokeAsync(PagoSeleccionado.PagosId)">
                        Aprobar Pago
                    </button>

                    <button type="button"
                            class="btn btn-danger w-50 bi bi-x-lg"
                            @onclick="() => OnRechazar.InvokeAsync(PagoSeleccionado.PagosId)">
                        Rechazar Pago
                    </button>
                </div>
            }
        }
    </div>
</div>

@code {
    [Parameter]
    public Pagos? PagoSeleccionado { get; set; }

    [Parameter]
    public EventCallback<int> OnAprobar { get; set; }

    [Parameter]
    public EventCallback<int> OnRechazar { get; set; }
}