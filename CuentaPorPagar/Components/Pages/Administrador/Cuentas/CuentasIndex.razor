@page "/Cuentas/Index"
@rendermode InteractiveServer
@using CuentasPorPagar.Components.Pages.Administrador.Cuentas
@inject ProveedoresService proveedoresService
@inject FacturaServices facturasService

<PageTitle>Consultar Cuenta</PageTitle>

<div class="container mt-4">
    <div class="card shadow-lg">
        @* Encabezado principal *@
        <div class="card-header d-flex align-items-center gap-3">
            <div class="bg-success text-white rounded p-2 d-flex align-items-center justify-content-center">
                <label class="bi bi-layers fs-4 mb-0"></label>
            </div>
            <div>
                <h5 class="card-title mb-0">Consultar Cuenta</h5>
                <span class="text-muted">
                    Consulta el estado de cuenta y las facturas de un proveedor.
                </span>
            </div>
        </div>

        <div class="card-body">
            @* Barra de seleccion de proveedor *@
            <div class="row g-3 align-items-center mb-4">
                <div class="col-md-1">
                    <label class="col-form-label"><strong>Proveedor:</strong></label>
                </div>

                <div class="col-md-9">
                    <InputSelect class="form-select" @bind-Value="ProveedorId">
                        <option value="0">Seleccionar Proveedor</option>
                        @foreach (var prov in proveedores)
                        {
                            <option value="@prov.ProveedorId">@prov.Nombre</option>
                        }
                    </InputSelect>
                </div>

                <div class="col-md-2">
                    <button type="button" class="btn btn-success w-100 bi bi-search" @onclick="Consultar">
                        Consultar
                    </button>
                </div>
            </div>

            @* Ficha del proveedor *@
            <div class="card bg-light border mb-4">
                <div class="card-body">
                    <div class="row g-3 align-items-center">
                        <div class="col-md-5 d-flex align-items-center gap-3">
                            <div class="bg-success text-white rounded p-2 d-flex align-items-center justify-content-center">
                                <label class="bi bi-shop fs-4 mb-0"></label>
                            </div>
                            <div>
                                <div class="fw-bold fs-5">
                                    @(proveedorSeleccionado.ProveedorId > 0 ? proveedorSeleccionado.Nombre : "--")
                                </div>
                                <span class="text-muted small">
                                    RNC: @(proveedorSeleccionado.ProveedorId > 0 ? proveedorSeleccionado.Rnc : "--")
                                </span>
                            </div>
                        </div>

                        <div class="col-md-3 d-flex align-items-center gap-2">
                            <label class="bi bi-telephone-fill text-success fs-4 mb-0"></label>
                            <div>
                                <div class="fw-bold small">Telefono</div>
                                <span class="text-muted small">
                                    @(proveedorSeleccionado.ProveedorId > 0 ? proveedorSeleccionado.Telefono : "--")
                                </span>
                            </div>
                        </div>

                        <div class="col-md-4 d-flex align-items-center gap-2">
                            <label class="bi bi-geo-alt-fill text-success fs-4 mb-0"></label>
                            <div>
                                <div class="fw-bold small">Direccion</div>
                                <span class="text-muted small">
                                    @(proveedorSeleccionado.ProveedorId > 0 ? proveedorSeleccionado.Direccion : "--")
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            @* Dos columnas: FacturasCuenta y Resumen de la Cuenta *@
            <div class="row g-4">
                <div class="col-md-7">
                    <FacturasCuentas Facturas="facturas" />
                </div>

                <div class="col-md-5">
                    <div class="card shadow-sm h-100">
                        <div class="card-header bg-white d-flex align-items-center gap-2">
                            <label class="bi bi-bar-chart-fill text-success fs-5 mb-0"></label>
                            <h6 class="mb-0 fw-bold">Resumen de la Cuenta</h6>
                        </div>

                        <div class="card-body d-flex flex-column justify-content-between">
                           <GraficaCuantas @key="ProveedorId"
                              Facturas="facturas" />

                            <div class="row g-2 mt-3">
                                <div class="col-4">
                                    <div class="card bg-success-subtle border-0 text-center p-2 h-100">
                                        <div><label class="bi bi-layers text-success fs-5 mb-0"></label></div>
                                        <div class="small text-muted fw-semibold">Total Facturado</div>
                                        <div class="fw-bold text-success small">RD$ @TotalFacturado.ToString("N2")</div>
                                    </div>
                                </div>

                                <div class="col-4">
                                    <div class="card bg-success-subtle border-0 text-center p-2 h-100">
                                        <div><label class="bi bi-check-circle text-success fs-5 mb-0"></label></div>
                                        <div class="small text-muted fw-semibold">Total Pagado</div>
                                        <div class="fw-bold text-success small">RD$ @TotalPagado.ToString("N2")</div>
                                    </div>
                                </div>

                                <div class="col-4">
                                    <div class="card bg-danger-subtle border-0 text-center p-2 h-100">
                                        <div><label class="bi bi-cash-coin text-danger fs-5 mb-0"></label></div>
                                        <div class="small text-muted fw-semibold">Saldo Pendiente</div>
                                        <div class="fw-bold text-danger small">RD$ @SaldoPendiente.ToString("N2")</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    public List<Proveedores> proveedores { get; set; } = new List<Proveedores>();
    public List<Facturas> facturas { get; set; } = new List<Facturas>();
    public Proveedores proveedorSeleccionado { get; set; } = new Proveedores();
    public int ProveedorId { get; set; }

    public double TotalFacturado { get; set; }
    public double TotalPagado { get; set; }
    public double SaldoPendiente { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var result = await proveedoresService.GetList(p => p.Estado);
        if (result.IsSuccess && result.Value != null)
        {
            proveedores = result.Value;
        }
    }

    public async Task Consultar()
    {
        if (ProveedorId > 0)
        {
            var prov = proveedores.FirstOrDefault(p => p.ProveedorId == ProveedorId);
            if (prov != null)
            {
                proveedorSeleccionado = prov;
            }

            var result = await facturasService.GetList(f => f.ProveedorId == ProveedorId);
            if (result.IsSuccess && result.Value != null)
            {
                facturas = result.Value;
            }
        }
        else
        {
            proveedorSeleccionado = new Proveedores();
            facturas = new List<Facturas>();
        }

        TotalFacturado = facturas.Sum(f => f.Detalles.Sum(d => d.Cantidad * d.Precio));
        TotalPagado = facturas.Where(f => f.Estado == "Pagada").Sum(f => f.Detalles.Sum(d => d.Cantidad * d.Precio));
        SaldoPendiente = facturas.Where(f => f.Estado != "Pagada").Sum(f => f.Detalles.Sum(d => d.Cantidad * d.Precio));
    }
}