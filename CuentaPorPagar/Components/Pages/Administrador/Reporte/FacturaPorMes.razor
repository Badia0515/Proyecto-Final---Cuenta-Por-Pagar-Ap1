@using ApexCharts
@using CuentasPorPagar.Data.Models

<div class="card shadow-sm h-100">
    <div class="card-header bg-white d-flex align-items-center gap-2">
        <label class="bi bi-bar-chart-line text-success fs-5 mb-0"></label>
        <h6 class="mb-0 fw-bold">Pagos por Mes</h6>
    </div>

    <div class="card-body">
        <ApexChart TItem="Pagos" Title="">
            <ApexPointSeries TItem="Pagos"
                             Items="Pagos"
                             SeriesType="SeriesType.Bar"
                             Name="Monto"
                             XValue="@(e => e.FechaProgramada.ToString("MMM"))"
                             YAggregate="@(e => e.Sum(p => (decimal)p.Monto))" />
        </ApexChart>
    </div>
</div>

@code {
    [Parameter]
    public List<Pagos> Pagos { get; set; } = new List<Pagos>();
}