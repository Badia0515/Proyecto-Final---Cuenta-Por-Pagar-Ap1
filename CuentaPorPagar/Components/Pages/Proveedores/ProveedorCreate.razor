@page "/Proveedor/Crear"
@rendermode InteractiveServer
@inject ProveedoresService proveedoresService
@inject NavigationManager navigationManager

<PageTitle>Crear Proveedor</PageTitle>

<EditForm Model="proveedor" OnValidSubmit="Guardar" FormName="Crear">
    <DataAnnotationsValidator />

    <div class="container mt-4">
        <div class="card shadow-lg">
            @* Encabezado principal *@
            <div class="card-header d-flex align-items-center gap-3">
                <div class="bg-success text-white rounded p-2 d-flex align-items-center justify-content-center">
                    <label class="bi bi-truck fs-4 mb-0"></label>
                </div>
                <div>
                    <h5 class="card-title mb-0">Crear Proveedor</h5>
                    <span class="text-muted">
                        Registra un nuevo proveedor en el sistema
                    </span>
                </div>
            </div>

            <div class="card-body">
                <div class="row">
                    @* Columna izquierda: Nombre, RNC y Telefono *@
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label class="form-label">
                                <span class="bi bi-person-fill text-success me-1"></span>
                                <strong>Nombre</strong>
                            </label>
                            <InputText class="form-control" placeholder="Ingrese el nombre del proveedor" @bind-Value="proveedor.Nombre" />
                            <ValidationMessage For="@(() => proveedor.Nombre)" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">
                                <span class="bi bi-card-heading text-success me-1"></span>
                                <strong>RNC</strong>
                            </label>
                            <InputText class="form-control" placeholder="Ingrese el RNC" @bind-Value="proveedor.Rnc" />
                            <ValidationMessage For="@(() => proveedor.Rnc)" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">
                                <span class="bi bi-telephone-fill text-success me-1"></span>
                                <strong>Telefono</strong>
                            </label>
                            <InputText class="form-control" placeholder="Ingrese el telefono" @bind-Value="proveedor.Telefono" />
                            <ValidationMessage For="@(() => proveedor.Telefono)" />
                        </div>
                    </div>

                    @* Columna derecha: Direccion *@
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label class="form-label">
                                <span class="bi bi-geo-alt-fill text-success me-1"></span>
                                <strong>Direccion</strong>
                            </label>
                            <InputTextArea class="form-control" rows="5" placeholder="Ingrese la direccion" @bind-Value="proveedor.Direccion" />
                            <ValidationMessage For="@(() => proveedor.Direccion)" />
                        </div>
                    </div>
                </div>
            </div>

            @* Footer con botones a la derecha *@
            <div class="card-footer d-flex justify-content-end gap-2">
                <button type="button" class="btn btn-secondary bi bi-arrow-left" @onclick="Volver">
                    Volver
                </button>
                <button type="submit" class="btn btn-success bi bi-floppy">
                    Guardar
                </button>
            </div>
        </div>
    </div>
</EditForm>

@code {
    public Proveedores proveedor { get; set; } = new();
    public ProveedorDetalle DetalleSeleccionado { get; set; } = new();
    public List<Proveedores> ListaProveedores { get; set; } = [];

    protected override async Task OnInitializedAsync()
    {
        var result = await proveedoresService.GetList(l => true);
        result.OnSuccess(l => ListaProveedores = l);
        DetalleSeleccionado.Cantidad = 1;
    }

    private async Task HandleProveedorSelected((Proveedores Proveedor, int cantidad) seleccion)
    {
        var yaExiste = proveedor.detalle.FirstOrDefault(l => l.ProveedorId == seleccion.Proveedor.ProveedorId);
        if(yaExiste != null)
        {
            yaExiste.Cantidad += seleccion.cantidad;
        }
        else
        {
            var detalle = new ProveedorDetalle
            {
                ProveedorId = seleccion.Proveedor.ProveedorId,
                Cantidad = seleccion.cantidad,
                Proveedor = seleccion.Proveedor
            };
            proveedor.detalle.Add(detalle);
        }

        proveedor.Balance = proveedor.detalle.Sum(p => p.Cantidad);
        DetalleSeleccionado = new ProveedorDetalle { Cantidad = 1 };
        await Task.CompletedTask;
    }

    public async Task Guardar()
    {
        if (string.IsNullOrWhiteSpace(proveedor.Direccion))
        {
            Console.WriteLine("El concepto es obligatorio");
            return;
        }
        // if(proveedor.detalle == null || !proveedor.detalle.Any())
        // {
        //     Console.WriteLine("Debe agregar al menos un proveedor en el detalle");
        //     return;
        // }

        var result = await proveedoresService.Guardar(proveedor);
        result.OnSuccess(() =>
        {
            Console.WriteLine("El proveedor fue registrado exitosamente");
            navigationManager.NavigateTo("/Proveedor/Index");
        });
    }

    private void Volver()
    {
        navigationManager.NavigateTo("/Proveedor/Index");
    }

    public void RemoverDetalle(ProveedorDetalle detalle)
    {
        proveedor.detalle.Remove(detalle);
        proveedor.Balance = proveedor.detalle.Sum(p => p.Cantidad);
        DetalleSeleccionado = detalle;
    }

    private string ObtenerNombreProveedor(int proveedorId)
    {
        return ListaProveedores.FirstOrDefault(p => p.ProveedorId == proveedorId)?.Nombre ?? $"Proveedor #{proveedorId}";
    }
}