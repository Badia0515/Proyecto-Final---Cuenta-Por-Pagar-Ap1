@page "/Devoluciones/Create"
@rendermode InteractiveServer
@inject DevolucionesService devolucionesService
@inject FacturaServices facturasService
@inject NavigationManager navigationManager

<PageTitle>Devolucion de Factura</PageTitle>

<div class="container mt-4">
    <div class="card shadow-lg">
        <div class="card-header d-flex align-items-center gap-3">
            <div class="bg-success text-white rounded p-2 d-flex align-items-center justify-content-center">
                <i class="bi bi-arrow-return-left fs-4"></i>
            </div>
            <div>
                <h5 class="card-title mb-0">Devolucion de Factura</h5>
                <span class="text-muted">
                    Registrar la devolucion de una factura pagada al proveedor
                </span>
            </div>
        </div>

        <div class="card-body">
            <EditForm Model="Devolucion" OnValidSubmit="Guardar" FormName="CrearDevolucion">
                <DataAnnotationsValidator />
                <ValidationSummary class="alert alert-danger" />

                @if (!string.IsNullOrEmpty(Error))
                {
                    <div class="alert alert-danger d-flex align-items-center gap-2" role="alert">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                        <span>@Error</span>
                    </div>
                }

                <div class="row">
                    @* Columna izquierda: Formulario Registrar Devolucion *@
                    <div class="col-md-7 mb-3">
                        <div class="card shadow-sm h-100">
                            <div class="card-header bg-success text-white">
                                <h6 class="mb-0">
                                    <i class="bi bi-file-earmark-plus me-2"></i>Registrar Devolucion
                                </h6>
                            </div>
                            <div class="card-body">

                                <div class="row mb-3 align-items-center">
                                    <label class="col-sm-4 col-form-label">
                                        <strong>Factura Pagada: <span class="text-danger">*</span></strong>
                                    </label>
                                    <div class="col-sm-8">
                                        <PickerFactura @bind-Value="Devolucion.FacturasId"
                                                       @bind-Value:after="OnFacturaChanged" />
                                        <ValidationMessage For="@(() => Devolucion.FacturasId)" />
                                    </div>
                                </div>

                                <div class="row mb-3 align-items-center">
                                    <label class="col-sm-4 col-form-label">
                                        <strong>Fecha de Devolucion: <span class="text-danger">*</span></strong>
                                    </label>
                                    <div class="col-sm-8">
                                        <InputDate class="form-control" @bind-Value="Devolucion.Fecha" />
                                        <ValidationMessage For="@(() => Devolucion.Fecha)" />
                                    </div>
                                </div>

                                <div class="row mb-3 align-items-center">
                                    <label class="col-sm-4 col-form-label">
                                        <strong>Monto: <span class="text-danger">*</span></strong>
                                    </label>
                                    <div class="col-sm-8">
                                        <InputNumber class="form-control" @bind-Value="Devolucion.Monto" />
                                        <ValidationMessage For="@(() => Devolucion.Monto)" />
                                    </div>
                                </div>

                                <div class="row mb-2">
                                    <label class="col-sm-4 col-form-label">
                                        <strong>Motivo: <span class="text-danger">*</span></strong>
                                    </label>
                                    <div class="col-sm-8">
                                        <InputTextArea class="form-control" rows="4" placeholder="Ingrese el motivo de la devolucion" @bind-Value="Devolucion.Motivo" />
                                        <ValidationMessage For="@(() => Devolucion.Motivo)" />
                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>

                    @* Columna derecha: Panel Informacion de la Factura *@
                    <div class="col-md-5 mb-3">
                        <div class="card shadow-sm h-100 bg-light">
                            <div class="card-header bg-light">
                                <h6 class="mb-0">
                                    <i class="bi bi-info-circle text-success me-2"></i>Informacion de la Factura
                                </h6>
                            </div>
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                                    <span class="text-success">
                                        <i class="bi bi-people me-1"></i><strong>Proveedor:</strong>
                                    </span>
                                    <span>
                                        @(FacturaSeleccionada?.Proveedor != null ? FacturaSeleccionada.Proveedor.Nombre : "--")
                                    </span>
                                </div>

                                <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                                    <span class="text-success">
                                        <i class="bi bi-file-earmark-text me-1"></i><strong>No. Factura:</strong>
                                    </span>
                                    <span>
                                        @(FacturaSeleccionada != null ? FacturaSeleccionada.NumFactura.ToString() : "--")
                                    </span>
                                </div>

                                <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                                    <span class="text-success">
                                        <i class="bi bi-calendar-event me-1"></i><strong>Fecha Factura:</strong>
                                    </span>
                                    <span>
                                        @(FacturaSeleccionada != null ? FacturaSeleccionada.Fecha.ToString("dd/MM/yyyy") : "--")
                                    </span>
                                </div>

                                <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                                    <span class="text-success">
                                        <i class="bi bi-cash me-1"></i><strong>Estado:</strong>
                                    </span>
                                    <span>
                                        @(FacturaSeleccionada != null ? FacturaSeleccionada.Estado : "--")
                                    </span>
                                </div>

                                <div class="d-flex justify-content-between align-items-center pt-2">
                                    <span class="text-success">
                                        <i class="bi bi-coin me-1"></i><strong>Monto Factura:</strong>
                                    </span>
                                    <span class="fw-bold text-success">RD$ @MontoFacturaSeleccionada.ToString("N2")</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                @* Botones inferiores *@
                <div class="d-flex justify-content-end gap-2 mt-3">
                    <button type="button" class="btn btn-outline-secondary" @onclick="Cancelar">
                        <i class="bi bi-x-lg me-1"></i>Cancelar
                    </button>
                    <button type="submit" class="btn btn-success">
                        <i class="bi bi-floppy me-1"></i>Registrar Devolucion
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
</div>

@code {
    public Devoluciones Devolucion { get; set; } = new Devoluciones();
    public List<Facturas> FacturasPagadas { get; set; } = new List<Facturas>();
    public Facturas? FacturaSeleccionada { get; set; }
    public double MontoFacturaSeleccionada { get; set; }
    public string Error { get; set; } = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        Devolucion.Fecha = DateOnly.FromDateTime(DateTime.Now);

        var resFacturas = await facturasService.GetList(f => f.Estado == "Pagada");
        if (resFacturas.IsSuccess && resFacturas.Value != null)
        {
            FacturasPagadas = resFacturas.Value;
        }
    }

    private void OnFacturaChanged()
    {
        Error = string.Empty;

        if (Devolucion.FacturasId == 0)
        {
            FacturaSeleccionada = null;
            MontoFacturaSeleccionada = 0;
            return;
        }

        FacturaSeleccionada = FacturasPagadas.FirstOrDefault(f => f.FacturasId == Devolucion.FacturasId);
        MontoFacturaSeleccionada = FacturaSeleccionada != null ? ObtenerMontoFactura(FacturaSeleccionada) : 0;
    }

    private double ObtenerMontoFactura(Facturas factura)
    {
        if (factura.Detalles == null)
        {
            return 0;
        }
        return (double)factura.Detalles.Sum(d => d.Cantidad * d.Precio);
    }

    private async Task Guardar()
    {
        Error = string.Empty;

        if (Devolucion.FacturasId == 0)
        {
            Error = "Debe seleccionar una factura pagada.";
            return;
        }

        if (Devolucion.Monto <= 0)
        {
            Error = "El monto de la devolucion debe ser mayor a cero.";
            return;
        }

        if (Devolucion.Monto > MontoFacturaSeleccionada)
        {
            Error = $"El monto a devolver (RD$ {Devolucion.Monto:N2}) no puede superar el monto de la factura (RD$ {MontoFacturaSeleccionada:N2}).";
            return;
        }

        var resultado = await devolucionesService.Guardar(Devolucion);
        if (resultado.IsSuccess)
        {
            navigationManager.NavigateTo("/Devoluciones/Index");
        }
        else
        {
            Error = resultado.Error.Description ?? "No se pudo registrar la devolucion.";
        }
    }

    private void Cancelar()
    {
        navigationManager.NavigateTo("/Devoluciones/Index");
    }
}