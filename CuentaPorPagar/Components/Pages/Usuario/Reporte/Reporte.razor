@page "/"
@rendermode InteractiveServer
@inject FacturaServices facturasService
@inject PagosService pagosService

<PageTitle>Reporte General</PageTitle>

<div class="container mt-4">
    <div class="card shadow-lg">
        @* Encabezado principal del Card *@
        <div class="card-header d-flex align-items-center gap-3">
            <div class="bg-success text-white rounded p-2 d-flex align-items-center justify-content-center">
                <label class="bi bi-bar-chart-fill fs-4 mb-0"></label>
            </div>
            <div>
                <h5 class="card-title mb-0">Reporte General</h5>
                <span class="text-muted">Resumen general de facturas y pagos registrados</span>
            </div>
        </div>

        <div class="card-body">
            @* Tarjetas KPI superiores *@
            <div class="row mb-4">
                <div class="col-md-4 mb-3">
                    <div class="card shadow-sm h-100">
                        <div class="card-body d-flex align-items-center gap-3">
                            <div class="bg-success text-white rounded-3 p-3 d-flex align-items-center justify-content-center">
                                <label class="bi bi-cash-coin fs-3 mb-0"></label>
                            </div>
                            <div>
                                <span class="text-muted">Total Pagado</span>
                                <h4 class="mb-0 fw-bold">RD$ @TotalPagado.ToString("N2")</h4>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-md-4 mb-3">
                    <div class="card shadow-sm h-100">
                        <div class="card-body d-flex align-items-center gap-3">
                            <div class="bg-warning text-white rounded-3 p-3 d-flex align-items-center justify-content-center">
                                <label class="bi bi-hourglass-split fs-3 mb-0"></label>
                            </div>
                            <div>
                                <span class="text-muted">Total Pendiente</span>
                                <h4 class="mb-0 fw-bold">RD$ @TotalPendiente.ToString("N2")</h4>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-md-4 mb-3">
                    <div class="card shadow-sm h-100">
                        <div class="card-body d-flex align-items-center gap-3">
                            <div class="bg-danger text-white rounded-3 p-3 d-flex align-items-center justify-content-center">
                                <label class="bi bi-exclamation-triangle fs-3 mb-0"></label>
                            </div>
                            <div>
                                <span class="text-muted">Total Vencido</span>
                                <h4 class="mb-0 fw-bold">RD$ @TotalVencido.ToString("N2")</h4>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            @* Fila central: Tabla de Facturas y Componente de Grafico Pie *@
            <div class="row mb-4">

                @* Tabla resumen de Facturas *@
                <div class="col-md-7 mb-3">
                    <div class="card shadow-sm h-100">
                        <div class="card-header bg-light d-flex align-items-center gap-2">
                            <label class="bi bi-file-earmark-text text-success fs-5 mb-0"></label>
                            <h6 class="mb-0 fw-bold">Facturas</h6>
                        </div>
                        <div class="card-body">
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="table-success">
                                        <tr>
                                            <th>ID</th>
                                            <th>Proveedor</th>
                                            <th>Fecha</th>
                                            <th>Monto</th>
                                            <th class="text-center">Estado</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (ListaFacturas.Count == 0)
                                        {
                                            <tr>
                                                <td colspan="5" class="text-center text-muted py-3">
                                                    No hay facturas registradas.
                                                </td>
                                            </tr>
                                        }
                                        else
                                        {
                                            @foreach (var item in ListaFacturas.Take(5))
                                            {
                                                <tr>
                                                    <td class="fw-semibold">@item.NumFactura.ToString("D5")</td>
                                                    <td>
                                                        @if (item.Proveedor != null)
                                                        {
                                                            @item.Proveedor.Nombre
                                                        }
                                                        else
                                                        {
                                                            <span>--</span>
                                                        }
                                                    </td>
                                                    <td>@item.Fecha.ToString("dd/MM/yyyy")</td>
                                                    <td class="fw-semibold">RD$ @ObtenerMontoFactura(item).ToString("N2")</td>
                                                    <td class="text-center">
                                                        @if (item.Estado == "Pagada")
                                                        {
                                                            <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-1">@item.Estado</span>
                                                        }
                                                        else if (item.Estado == "Vencida")
                                                        {
                                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-3 py-1">@item.Estado</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle px-3 py-1">@item.Estado</span>
                                                        }
                                                    </td>
                                                </tr>
                                            }
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

                @* Componente separado de Grafico Pie *@
                <div class="col-md-5 mb-3">
                    <div class="card shadow-sm h-100">
                        <div class="card-header bg-light d-flex align-items-center gap-2">
                            <label class="bi bi-pie-chart-fill text-success fs-5 mb-0"></label>
                            <h6 class="mb-0 fw-bold">Porcentaje Por Estado</h6>
                        </div>
                        <div class="card-body d-flex align-items-center justify-content-center">
                            <GraficoEstadoFacturas Facturas="ListaFacturas" />
                        </div>
                    </div>
                </div>

            </div>

            @* Fila inferior: Componente separado de Grafico de Barras *@
            <div class="row">
                <div class="col-12">
                    <div class="card shadow-sm">
                        <div class="card-header bg-light d-flex align-items-center gap-2">
                            <label class="bi bi-bar-chart-line-fill text-success fs-5 mb-0"></label>
                            <h6 class="mb-0 fw-bold">Pagos por Mes</h6>
                        </div>
                        <div class="card-body">
                            <GraficoPagosMes Pagos="ListaPagos" />
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    public List<Facturas> ListaFacturas { get; set; } = new List<Facturas>();
    public List<Pagos> ListaPagos { get; set; } = new List<Pagos>();
    public double TotalPagado { get; set; }
    public double TotalPendiente { get; set; }
    public double TotalVencido { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var resFacturas = await facturasService.GetList(f => true);
        if (resFacturas.IsSuccess && resFacturas.Value != null)
        {
            ListaFacturas = resFacturas.Value
                .OrderByDescending(f => f.FacturasId)
                .ToList();
        }

        var resPagos = await pagosService.GetList(p => p.Estado == "Pagado");
        if (resPagos.IsSuccess && resPagos.Value != null)
        {
            ListaPagos = resPagos.Value
                .OrderBy(p => p.FechaProgramada)
                .ToList();
        }

        var resTotalPagado = await pagosService.GetTotalPorEstado("Pagado");
        if (resTotalPagado.IsSuccess)
        {
            TotalPagado = resTotalPagado.Value;
        }

        var resTotalPendiente = await pagosService.GetTotalPorEstado("Pendiente de aprobacion");
        if (resTotalPendiente.IsSuccess)
        {
            TotalPendiente = resTotalPendiente.Value;
        }

        if (TotalPendiente == 0)
        {
            TotalPendiente = ListaFacturas
                .Where(f => f.Estado == "Pendiente")
                .Sum(f => ObtenerMontoFactura(f));
        }

        TotalVencido = ListaFacturas
            .Where(f => f.Estado == "Vencida")
            .Sum(f => ObtenerMontoFactura(f));
    }

    private double ObtenerMontoFactura(Facturas factura)
    {
        if (factura.Detalles == null)
        {
            return 0;
        }
        return (double)factura.Detalles.Sum(d => d.Cantidad * d.Precio);
    }
}