@page "/Proveedor/Editar/{ProveedorId:int}"
@rendermode InteractiveServer
@inject ProveedoresService proveedoresService
@inject NavigationManager navigationManager

<PageTitle>Editar Proveedor</PageTitle>

<EditForm Model="proveedor" OnValidSubmit="Guardar" FormName="EditarProveedor">
    <DataAnnotationsValidator />

    <div class="container mt-4">
        <div class="card shadow-lg">
            @* Encabezado principal *@
            <div class="card-header d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center gap-3">
                    <div class="bg-success text-white rounded p-2 d-flex align-items-center justify-content-center">
                        <label class="bi bi-truck fs-4 mb-0"></label>
                    </div>
                    <div>
                        <h5 class="card-title mb-0">Editar Proveedor</h5>
                        <span class="text-muted">
                            Modifica los datos del proveedor seleccionado
                        </span>
                    </div>
                </div>

                <span class="badge bg-light text-dark border px-3 py-2">
                    ID: @proveedor.ProveedorId.ToString("D3")
                </span>
            </div>

            <div class="card-body">
                <div class="row">
                    @* Columna izquierda: Nombre, RNC y Telefono *@
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label class="form-label">
                                <span class="bi bi-person-fill text-success me-1"></span>
                                <strong>Nombre</strong>
                            </label>
                            <InputText class="form-control" placeholder="Ingrese el nombre del proveedor" @bind-Value="proveedor.Nombre" />
                            <ValidationMessage For="@(() => proveedor.Nombre)" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">
                                <span class="bi bi-card-heading text-success me-1"></span>
                                <strong>RNC</strong>
                            </label>
                            <InputText class="form-control" placeholder="Ingrese el RNC" @bind-Value="proveedor.Rnc" />
                            <ValidationMessage For="@(() => proveedor.Rnc)" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">
                                <span class="bi bi-telephone-fill text-success me-1"></span>
                                <strong>Telefono</strong>
                            </label>
                            <InputText class="form-control" placeholder="Ingrese el telefono" @bind-Value="proveedor.Telefono" />
                            <ValidationMessage For="@(() => proveedor.Telefono)" />
                        </div>
                    </div>

                    @* Columna derecha: Direccion y Estado *@
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label class="form-label">
                                <span class="bi bi-geo-alt-fill text-success me-1"></span>
                                <strong>Direccion</strong>
                            </label>
                            <InputTextArea class="form-control" rows="4" placeholder="Ingrese la direccion" @bind-Value="proveedor.Direccion" />
                            <ValidationMessage For="@(() => proveedor.Direccion)" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">
                                <span class="bi bi-toggle-on text-success me-1"></span>
                                <strong>Estado</strong>
                            </label>
                            <InputSelect class="form-select" @bind-Value="proveedor.Estado">
                                <option value="true">Activo</option>
                                <option value="false">Inactivo</option>
                            </InputSelect>
                        </div>
                    </div>
                </div>
            </div>

            @* Footer con botones a la derecha *@
            <div class="card-footer d-flex justify-content-end gap-2">
                <button type="button" class="btn btn-secondary bi bi-arrow-left" @onclick="Volver">
                    Volver
                </button>
                <button type="submit" class="btn btn-success bi bi-floppy">
                    Guardar
                </button>
            </div>
        </div>
    </div>
</EditForm>

@code {
    [Parameter]
    public int ProveedorId { get; set; }

    public Proveedores proveedor { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        if (ProveedorId > 0)
        {
            var result = await proveedoresService.Buscar(ProveedorId);
            if (result.IsSuccess && result.Value != null)
            {
                proveedor = result.Value;
            }
        }
    }

    public async Task Guardar()
    {
        if (string.IsNullOrWhiteSpace(proveedor.Direccion))
        {
            return;
        }

        var result = await proveedoresService.Guardar(proveedor);
        if (result.IsSuccess)
        {
            navigationManager.NavigateTo("/Proveedor/Index");
        }
    }

    private void Volver()
    {
        navigationManager.NavigateTo("/Proveedor/Index");
    }
}