@page "/Transacciones/Index"
@rendermode InteractiveServer
@inject TransaccionServices transaccionesService
@inject NavigationManager navigationManager
<PageTitle>Historial de Transacciones</PageTitle>

<div class="container mt-4">
    <div class="card shadow-lg">
        <div class="card-header">
            <h5 class="card-title mb-0">Historial de Transacciones</h5>
            <p class="text-muted mb-0">
                Auditoria y seguimiento de movimientos realizados en pagos
            </p>
        </div>

        <div class="card-body">

            @* Filtros *@
            <div class="row align-items-end mb-4">
                <div class="col-md-3 mb-2">
                    <label class="form-label"><strong>Accion:</strong></label>
                    <InputSelect class="form-select" @bind-Value="FiltroAccion">
                        <option value="Todos">Todos</option>
                        <option value="Pago Programado">Pago Programado</option>
                        <option value="Pago Aprobado">Pago Aprobado</option>
                        <option value="Pago Rechazado">Pago Rechazado</option>
                        <option value="Pago Emitido">Pago Emitido</option>
                    </InputSelect>
                </div>

                <div class="col-md-3 mb-2">
                    <label class="form-label"><strong>Desde:</strong></label>
                    <InputDate class="form-control" @bind-Value="FechaDesde" />
                </div>

                <div class="col-md-3 mb-2">
                    <label class="form-label"><strong>Hasta:</strong></label>
                    <InputDate class="form-control" @bind-Value="FechaHasta" />
                </div>

                <div class="col-md-3 mb-2 d-flex gap-2">
                    <button type="button" class="btn btn-success" @onclick="Buscar">
                        Buscar
                    </button>

                    <button type="button" class="btn btn-secondary" @onclick="Restablecer">
                        Limpiar
                    </button>
                </div>
            </div>

            @* Tabla de transacciones *@
            <div class="table-responsive">
                <table class="table table-bordered table-hover align-middle">
                    <thead class="table-success">
                        <tr>
                            <th>Id Transaccion</th>
                            <th>Id Pago</th>
                            <th>No. Factura</th>
                            <th>Usuario</th>
                            <th>Accion</th>
                            <th>Fecha</th>
                            <th>Detalle</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (ListaTransacciones.Count == 0)
                        {
                            <tr>
                                <td colspan="7" class="text-center text-muted py-3">
                                    No hay transacciones registradas para mostrar.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in ListaTransacciones)
                            {
                                <tr>
                                    <td>@item.TransaccionId</td>
                                    <td>@item.PagoId</td>
                                    <td>
                                        @if (item.Pago != null)
                                        {
                                            @item.Pago.FacturaId
                                        }
                                        else
                                        {
                                            <span>--</span>
                                        }
                                    </td>
                                    <td>
                                        @if (item.Usuario != null)
                                        {
                                            @item.Usuario.Nombre
                                        }
                                        else
                                        {
                                            @item.UsuarioId
                                        }
                                    </td>
                                    <td>
                                        @if (item.Accion == "Pago Emitido")
                                        {
                                            <span class="badge bg-success">@item.Accion</span>
                                        }
                                        else if (item.Accion == "Pago Aprobado")
                                        {
                                            <span class="badge bg-info text-dark">@item.Accion</span>
                                        }
                                        else if (item.Accion == "Pago Programado")
                                        {
                                            <span class="badge bg-warning text-dark">@item.Accion</span>
                                        }
                                        else if (item.Accion == "Pago Rechazado")
                                        {
                                            <span class="badge bg-danger">@item.Accion</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">@item.Accion</span>
                                        }
                                    </td>
                                    <td>@item.Fecha.ToString("dd/MM/yyyy")</td>
                                    <td>@item.Detalle</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            <div class="d-flex justify-content-between align-items-center mt-3">
                <span class="text-muted">Total de registros: @ListaTransacciones.Count</span>
                <a href="/Pagos/Index" class="btn btn-secondary">
                    Volver
                </a>
            </div>

        </div>
    </div>
</div>

@code {
    public List<Transacciones> ListaTransacciones { get; set; } = new List<Transacciones>();
    public string FiltroAccion { get; set; } = "Todos";
    public DateOnly FechaDesde { get; set; } = DateOnly.FromDateTime(DateTime.Now.AddMonths(-1));
    public DateOnly FechaHasta { get; set; } = DateOnly.FromDateTime(DateTime.Now);

    protected override async Task OnInitializedAsync()
    {
        var result = await transaccionesService.GetList(t => true);
        if (result.IsSuccess)
        {
            ListaTransacciones = result.Value.OrderByDescending(t => t.TransaccionId).ToList();
        }
    }

    private async Task Buscar()
    {
        var result = await transaccionesService.GetList(t =>
            (FiltroAccion == "Todos" || t.Accion == FiltroAccion) &&
            t.Fecha >= FechaDesde &&
            t.Fecha <= FechaHasta
        );

        if (result.IsSuccess)
        {
            ListaTransacciones = result.Value.OrderByDescending(t => t.TransaccionId).ToList();
        }
    }

    private async Task Restablecer()
    {
        FiltroAccion = "Todos";
        FechaDesde = DateOnly.FromDateTime(DateTime.Now.AddMonths(-1));
        FechaHasta = DateOnly.FromDateTime(DateTime.Now);

        var result = await transaccionesService.GetList(t => true);
        if (result.IsSuccess)
        {
            ListaTransacciones = result.Value.OrderByDescending(t => t.TransaccionId).ToList();
        }
    }
}
